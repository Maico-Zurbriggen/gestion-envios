# Copiar este archivo a ".env" en la carpeta Back/ y ajustar los valores segun el entorno.
# Nunca commitear el archivo ".env" real (ya esta en .gitignore).
# Detalle de cada variable: Back/docs/02-configuracion/variables-de-entorno.md

# --- General ---
PROJECT_NAME="Sistema de Gestion de Envios"
ENVIRONMENT=development
DEBUG=true

# --- Base de datos ---
# SQLite para desarrollo local (no requiere instalar nada mas):
DATABASE_URL=sqlite+aiosqlite:///./gestion_envios.db
# Neon (PostgreSQL): pegar el connection string "pooled" tal como lo copia el panel de Neon
# (tambien sirve el formato psql '...'). El codigo ajusta el esquema y fuerza SSL.
# Ver Back/docs/02-configuracion/base-de-datos-neon.md
# DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Endpoint directo para Alembic. Vacio: se deriva de DATABASE_URL quitando "-pooler".
# DATABASE_URL_MIGRACIONES=
# Al arrancar, la API aplica las migraciones pendientes (alembic upgrade head).
# DB_ACTUALIZAR_ESQUEMA_AL_INICIAR=true

# --- Seguridad / JWT ---
# Generar un valor propio y unico por entorno (minimo 32 caracteres). Nunca reusar el de ejemplo.
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars-long!
JWT_ALGORITHM=HS256
JWT_EXPIRATION=8h
JWT_TEMP_TOKEN_EXPIRATION=15m
BCRYPT_SALT_ROUNDS=12

# --- Semilla del Superadministrador (se crea automaticamente al iniciar la API si no existe) ---
SUPERADMIN_SEED_PASSWORD=SuperAdmin2026!*
SUPERADMIN_SEED_DNI=00000000
SUPERADMIN_SEED_EMAIL=admin@empresa.com
SUPERADMIN_SEED_NOMBRE="Admin General"
SUPERADMIN_SEED_TELEFONO=+5493564000000

# --- Avisos por email (HU05 y HU14) ---
# mock: solo deja el aviso en el log. gmail: completa smtp.gmail.com:587 (usar contrasena de aplicacion).
EMAIL_PROVIDER=mock
# SMTP_USER=cuenta@gmail.com
# SMTP_PASSWORD=contrasena-de-aplicacion
# SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Gestion de Envios"
# Con EMAIL_PROVIDER=smtp:
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# Direccion del frontend: arma el enlace de seguimiento de cada aviso.
FRONTEND_BASE_URL=http://localhost:5173

# --- Avisos por WhatsApp (HU05, HU12 y HU14) ---
# mock | twilio | meta | deshabilitado
WHATSAPP_PROVIDER=mock
# Twilio (sandbox por defecto). Sin plantillas aprobadas se envia texto libre.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_CONTENT_SID_NUEVO_ENVIO=
# TWILIO_CONTENT_SID_VISITA_FALLIDA=
# TWILIO_CONTENT_SID_AVISO_ESTADO=
# Meta WhatsApp Cloud API. Sin plantillas solo se entrega dentro de la ventana de 24 h.
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_PLANTILLA_NUEVO_ENVIO=
# WHATSAPP_META_PLANTILLA_VISITA_FALLIDA=
# WHATSAPP_META_PLANTILLA_AVISO_ESTADO=
# WHATSAPP_META_IDIOMA_PLANTILLA=es_AR

# --- Circuito logistico (HU12 y HU14) ---
# MAX_VISITAS_DOMICILIO=2
# PLAZO_RETIRO_DIAS_HABILES=7
# VENCIMIENTO_PRE_REGISTRO_DIAS=10
# Revision automatica de plazos vencidos, en minutos (0 la desactiva).
# INTERVALO_PLAZOS_MINUTOS=30

# --- Mapas (como en Rumbo) ---
# Recorridos por calles y orden de visita por tiempo real de manejo. Por defecto, el servidor
# publico de demostracion de OSRM (uso liviano). En produccion, el propio: ver deploy/osrm.
# OSRM_URL=http://localhost:5000
# Ubicacion de direcciones: Georef (Estado Argentino) y, de respaldo, Nominatim (OpenStreetMap).
# GEOREF_HABILITADO=true
# NOMINATIM_URL=https://nominatim.openstreetmap.org
