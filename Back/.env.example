# Copiar este archivo a ".env" en la carpeta Back/ y ajustar los valores segun el entorno.
# Nunca commitear el archivo ".env" real (ya esta en .gitignore).

# --- General ---
PROJECT_NAME="Sistema de Gestion de Envios"
ENVIRONMENT=development
DEBUG=true

# --- Base de datos ---
# SQLite para desarrollo local (no requiere instalar nada mas):
DATABASE_URL=sqlite+aiosqlite:///./gestion_envios.db
# Neon (PostgreSQL): usar el connection string "pooled" del panel de Neon,
# cambiando "postgresql://" por "postgresql+asyncpg://" y SIN el "?sslmode=require"
# del final (el codigo ya fuerza SSL por su cuenta, ver infrastructure/db/session.py).
# Ver Back/docs/01-arquitectura/plan-base-de-datos-completo.md seccion 8.
# DATABASE_URL=postgresql+asyncpg://usuario:password@ep-xxxx-pooler.neon.tech/nombre-db

# --- Seguridad / JWT ---
# Generar un valor propio y unico por entorno (minimo 32 caracteres). Nunca reusar el de ejemplo.
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars-long!
JWT_ALGORITHM=HS256
JWT_EXPIRATION=8h
JWT_TEMP_TOKEN_EXPIRATION=15m
BCRYPT_SALT_ROUNDS=12

# --- Semilla del Superadministrador (se crea automaticamente al iniciar la API si no existe) ---
SUPERADMIN_SEED_PASSWORD=SuperAdmin2026!*
SUPERADMIN_SEED_DNI=00000000
SUPERADMIN_SEED_EMAIL=admin@empresa.com
SUPERADMIN_SEED_NOMBRE="Admin General"
SUPERADMIN_SEED_TELEFONO=+5493564000000